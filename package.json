{
  "name": "layoutpdf",
  "version": "0.1.0",
  "description": "Design document layouts on a canvas and export them as PDF, in the browser or on the server",
  "type": "module",
  "license": "MIT",
  "author": "LayoutPDF contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goooooooooooooo/layoutpdf.git"
  },
  "homepage": "https://github.com/Goooooooooooooo/layoutpdf#readme",
  "bugs": {
    "url": "https://github.com/Goooooooooooooo/layoutpdf/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "./dist/designer.js",
    "./dist/pdf-worker.js"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pdf",
    "pdf-generation",
    "layout",
    "document-layout",
    "template",
    "document",
    "renderer",
    "designer",
    "wysiwyg",
    "web-component",
    "custom-element"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./pdf": {
      "types": "./dist/types/pdf.d.ts",
      "import": "./dist/pdf.js"
    },
    "./pdf/node": {
      "types": "./dist/types/pdf-node.d.ts",
      "import": "./dist/pdf-node.js"
    },
    "./pdf/worker": {
      "types": "./dist/types/pdf-worker.d.ts",
      "import": "./dist/pdf-worker.js"
    },
    "./plugins": {
      "types": "./dist/types/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./plugins/basic": {
      "types": "./dist/types/plugins/basic.d.ts",
      "import": "./dist/plugins-basic.js"
    },
    "./plugins/business": {
      "types": "./dist/types/plugins/business.d.ts",
      "import": "./dist/plugins-business.js"
    },
    "./preview-react": {
      "types": "./dist/types/preview-react.d.ts",
      "import": "./dist/preview-react.js"
    },
    "./preview-dom": {
      "types": "./dist/types/preview-dom.d.ts",
      "import": "./dist/preview-dom.js"
    },
    "./presets": {
      "types": "./dist/types/presets/index.d.ts",
      "import": "./dist/presets.js"
    },
    "./i18n": {
      "types": "./dist/types/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./schema/template.schema.json": "./docs/schema/template.schema.json",
    "./designer": {
      "types": "./dist/types/designer/index.d.ts",
      "import": "./dist/designer.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.types.json && tsc-alias -p tsconfig.types.json && node scripts/copy-assets.mjs",
    "smoke": "node scripts/smoke-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:update-golden": "UPDATE_GOLDEN=1 tsx --test \"src/**/golden*.test.ts\"",
    "check": "npm run typecheck && npm run test",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check:tarball": "node scripts/check-package.mjs",
    "check:install": "node scripts/check-install.mjs",
    "check:dist": "npm run smoke && npm run check:tarball && npm run check:install && npm run check:package",
    "verify": "npm run check && npm run build && npm run check:dist",
    "dev:example": "npm run build && vite --config examples/designer/vite.config.ts",
    "dev:core-example": "npm run build && vite --config examples/quickstart/vite.config.ts",
    "dev:worker-example": "npm run build && vite --config examples/worker/vite.config.ts",
    "dev:node-example": "npm run build && tsx examples/node/quote.ts",
    "docs:schema": "tsx scripts/generate-schema.ts",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.5.438",
    "qrcode-generator": "2.0.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "react": "^19.2.7",
    "react-dom": "^19.3.1",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^6.4.3"
  }
}
